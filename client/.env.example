# ============================================================
# DivYatra Client — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Express API base URL (local dev)
VITE_API_URL=http://localhost:5000/api

# ── Supabase (required for production auth) ──────────────────
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: The SUPABASE_SERVICE_ROLE_KEY must NEVER appear here.
# It belongs only in server/.env and must never be VITE_ prefixed.
