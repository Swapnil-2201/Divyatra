# ============================================================
# DivYatra Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ── MongoDB (optional \u2014 in-memory fallback used if not set) ────
MONGODB_URI=

# ── Supabase (required for production auth + audit logging) ──
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# WARNING: KEEP THIS SECRET. Server-only. Never expose to frontend.
# This key bypasses RLS and can read/write any data.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Optional API Keys ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FIREBASE_SERVER_KEY=
GOOGLE_MAPS_API_KEY=
